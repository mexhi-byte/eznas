# Copy to .env and fill in. Never commit the result.

# The port the console listens on.
PORT=80

# The first admin account is created from these on first run, then the account
# lives in data/accounts.json and these are only a seed. Both are optional: with
# no UI_PASSWORD the console generates one, prints it once in its log, and
# makes you replace it before anything else.
UI_USERNAME=admin
#UI_PASSWORD=

# Signs sessions AND derives the key that encrypts stored credentials.
# Changing it invalidates every session and every stored API key.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Optional: adopt a NAS on first run instead of adding one in the UI.
#TRUENAS_URL=wss://10.0.0.10/api/current
#TRUENAS_API_KEY=1-...
#TRUENAS_NAME=TrueNAS
#TRUENAS_FINGERPRINT=

# Which GitHub repository the in-app updater reads releases from.
UPDATE_REPO=mexhi-byte/eznas
RELEASE_CHANNEL=demo
