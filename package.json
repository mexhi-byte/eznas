{
  "name": "eznas",
  "version": "0.5.1",
  "description": "EzNAS \u2014 a beautifully simplified, open-source web UI for TrueNAS. Built for homelabs, powered by WebSockets.",
  "main": "index.js",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mexhi-byte/eznas.git"
  },
  "bugs": {
    "url": "https://github.com/mexhi-byte/eznas/issues"
  },
  "homepage": "https://github.com/mexhi-byte/eznas#readme"
}
