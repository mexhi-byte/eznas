{
  "name": "eznas",
  "version": "0.6.0",
  "description": "EzNAS — a beautifully simplified, open-source web UI for TrueNAS. Built for homelabs, powered by WebSockets.",
  "main": "index.js",
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node --watch --experimental-strip-types server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.js",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "mock": "node --experimental-strip-types mock/truenas-mock.ts",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.21.3"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mexhi-byte/eznas.git"
  },
  "bugs": {
    "url": "https://github.com/mexhi-byte/eznas/issues"
  },
  "homepage": "https://github.com/mexhi-byte/eznas#readme"
}
