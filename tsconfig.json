{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "web",
    "server",
    "test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
